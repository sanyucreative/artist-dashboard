// Artist CRM -- v1 schema (build spec phases 1-10, plus two competitor-
// derived additions). Postgres in both dev and prod: local dev runs against
// a real local Postgres branch Netlify CLI provisions automatically via
// `netlify dev` (NETLIFY_DB_URL), production against the Netlify-managed
// Neon database provisioned on deploy (same env var name). Started on
// sqlite for local-only dev before this was deployed; kept the schema
// enum-free (plain String fields, allowed values documented inline) and
// array-free (JSON-stringified fields) from that period since it costs
// nothing on Postgres either and avoids ever being tied to one engine.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (NextAuth / Auth.js v5, email magic link) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // disciplines: string[] (visual art, photography, writing, performance, music, design, ...)
  disciplines String @default("[]")
  timezone    String?

  accounts   Account[]
  sessions   Session[]
  workspaces Workspace[]
  feedback   Feedback[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Workspace ----------
// Keeps a professional identity (e.g. a design studio) separate from an art
// practice. Every domain record below belongs to exactly one workspace.

model Workspace {
  id     String @id @default(cuid())
  userId String
  name   String
  // type: free text, e.g. "art practice", "design studio"
  type   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects       Project[]
  opportunities  Opportunity[]
  applications   Application[]
  assets         Asset[]
  cvEntries      CVEntry[]
  contacts       Contact[]
  tasks          Task[]
  taskCategories TaskCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A user-defined grouping of tasks -- each one renders as its own widget on
// the dashboard, the same as Overview/Deadlines/etc. Tasks with no category
// (categoryId null) are legacy rows from before categories existed, or a
// brand-new workspace that hasn't made one yet; the dashboard shows those
// under a default "Tasks" widget rather than requiring one to exist.
model TaskCategory {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  position    Int    @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  createdAt DateTime @default(now())
}

// A lightweight to-do, scoped to the workspace rather than any one project
// or opportunity -- the dashboard's quick task widget, not a project plan.
model Task {
  id          String   @id @default(cuid())
  workspaceId String
  categoryId  String?
  title       String
  done        Boolean  @default(false)
  position    Int      @default(0)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Project ----------

model Project {
  id           String  @id @default(cuid())
  workspaceId  String
  title        String
  workingTitle String?
  // status: active | dormant | complete | ongoing
  status       String  @default("active")
  description  String?
  startDate    DateTime?
  medium       String?
  // themes: string[] tags, stored as a JSON array string
  themes       String  @default("[]")
  // Some projects are designed to keep growing and never close -- the UI
  // must not push these toward "complete".
  isOngoing    Boolean @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  participants Participant[]
  assets       Asset[]
  milestones   Milestone[]
  cvEntries    CVEntry[]
  applications ApplicationProject[]
  contacts     ContactProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Participant {
  id            String  @id @default(cuid())
  projectId     String
  name          String
  role          String?
  contactEmail  String?
  // consentStatus: not_requested | requested | granted | declined | expired
  consentStatus String  @default("not_requested")
  notes         String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  title     String
  dueDate   DateTime?
  // status: planned | in_progress | done
  status    String    @default("planned")
  notes     String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Opportunity / Application ----------

model Opportunity {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  organization String?
  // type: grant | residency | fellowship | exhibition_call | commission | mentorship | award
  type        String    @default("grant")
  url         String?
  deadline    DateTime?
  notifyAt    DateTime?
  // Set once the deadline reminder email has actually gone out, so the
  // scheduled reminder job doesn't re-send it every day after notifyAt passes.
  notifiedAt  DateTime?
  feeAmount   Float?
  awardAmount Float?
  discipline  String?
  eligibilityNotes String?
  isRecurring Boolean   @default(false)
  // recurrenceCadence: free text, e.g. "annual"
  recurrenceCadence String?

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  applications Application[]
  contacts     ContactOpportunity[]
  eligibilityCriteria EligibilityCriterion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A structured checklist per opportunity, alongside the free-text
// eligibilityNotes -- per spec: "many rejections come from eligibility
// criteria the artist could have verified in advance," a checkbox list is
// what actually gets checked before submitting, not a paragraph of notes.
model EligibilityCriterion {
  id            String  @id @default(cuid())
  opportunityId String
  label         String
  checked       Boolean @default(false)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Application {
  id            String    @id @default(cuid())
  opportunityId String
  workspaceId   String
  // status: researching | drafting | submitted | under_review | decision
  status        String    @default("researching")
  submittedAt   DateTime?
  decisionAt    DateTime?
  // outcome: accepted | declined | ineligible | withdrawn | waitlisted | no_response | null (no decision yet)
  outcome       String?
  outcomeReason String?
  // outcomeReasonCode: eligibility_not_met | insufficient_documentation | competitive_pool |
  //   lottery | budget_scope | weak_work_samples | misaligned_with_program | no_reason_given | other
  outcomeReasonCode String?
  canReapply    Boolean   @default(false)
  reapplyDate   DateTime?
  feedbackReceived String?
  // "what I'd change" -- written at decision time while it's fresh
  retro         String?

  opportunity Opportunity           @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    ApplicationProject[]
  assetsUsed  ApplicationAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Application <-> Project many-to-many
model ApplicationProject {
  applicationId String
  projectId     String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([applicationId, projectId])
}

// Application <-> Asset many-to-many (which images/statements/CV version went in)
model ApplicationAsset {
  applicationId String
  assetId       String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  asset       Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([applicationId, assetId])
}

// ---------- Asset library ----------

model Asset {
  id          String   @id @default(cuid())
  workspaceId String
  // type: image | artist_statement | bio | cv | work_sample | budget | letter_of_support | other
  type        String
  title       String
  fileUrl     String?
  version     String?
  projectId   String?
  notes       String?

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  usedIn    ApplicationAsset[]

  createdAt DateTime @default(now())
}

// ---------- CV ----------

model CVEntry {
  id          String    @id @default(cuid())
  workspaceId String
  // category: exhibition | award | residency | publication | talk | press
  category    String
  title       String
  organization String?
  location    String?
  date        DateTime?
  description String?
  // set automatically when an application's outcome becomes "accepted"
  sourceApplicationId String?
  isPublic    Boolean   @default(true)
  // Not in the spec's original CVEntry fields, but the Projects screen asks
  // for "exhibition history" on a project's detail page -- an optional link
  // lets exhibition/award/etc. entries surface there without a second model.
  projectId   String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ---------- Contacts ----------

model Contact {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  organization String?
  role        String?
  email       String?
  phone       String?
  // relationshipType: funder | curator | gallerist | collaborator | mentor | press
  relationshipType String?
  notes       String?
  lastContactedAt DateTime?
  // Free-form tags (not in the spec's Contact model): Artwork Archive's own
  // users rely on these for nuance beyond a fixed relationship type, e.g.
  // "warm intro", "board member". Stored the same way as Project.themes.
  tags String @default("[]")
  // Follow-up reminder: a date + note set from the contact's own record, e.g.
  // "mentioned wanting a preview of the fall show -- follow up". Surfaced on
  // the Contacts list and the Dashboard once due.
  nextFollowUpDate DateTime?
  followUpNote     String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunities ContactOpportunity[]
  projects      ContactProject[]

  createdAt DateTime @default(now())
}

// Not in the spec's own Contact data model, but the Contacts screen asks to
// "link contacts to opportunities and projects" -- same kind of gap as
// CVEntry/project above, filled the same way with a small join table.
model ContactOpportunity {
  contactId     String
  opportunityId String

  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@id([contactId, opportunityId])
}

model ContactProject {
  contactId String
  projectId String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([contactId, projectId])
}

// Tester feedback submitted from the sidebar. userId is nulled (not cascaded)
// if the account is deleted, so the feedback itself survives.
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  message   String
  page      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Emails allowed to sign in during the invite-only test. Managed from the
// /invites page (admins only), so adding a tester never needs a deploy.
model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
